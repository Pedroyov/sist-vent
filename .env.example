# Copia este archivo como .env y ajusta los valores.

# Genera una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambia-esta-clave

# True solo en desarrollo
DEBUG=True

# Separar con comas. Incluye la IP de tu PC para probar desde el celular en la misma red WiFi.
ALLOWED_HOSTS=localhost,127.0.0.1

# Nombre del colegio que aparece en el sistema
COLEGIO_NOMBRE=I.E.P. Mi Colegio
COLEGIO_NOMBRE_CORTO=MiColegio

# Base de datos (si no se define, usa SQLite)
# DATABASE_URL=postgres://usuario:clave@localhost:5432/sistgestion

# Días que dura la sesión antes de pedir de nuevo la contraseña
# SESSION_DIAS=7

# En producción (DEBUG=False) la SECRET_KEY debe ser larga y secreta: el sistema no arranca con la de ejemplo.
# Las fotos y vouchers se sirven en /archivos/ solo a usuarios con permiso: no publiques la carpeta media/ en el servidor.
