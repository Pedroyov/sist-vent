# Copia este archivo como .env y ajusta los valores.

# Genera una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambia-esta-clave

# True solo en desarrollo
DEBUG=True

# Separar con comas. Incluye la IP de tu PC para probar desde el celular en la misma red WiFi.
ALLOWED_HOSTS=localhost,127.0.0.1

# Nombre del negocio (se usa mientras no se llenen los Datos del negocio)
NEGOCIO_NOMBRE=Mi Negocio
NEGOCIO_NOMBRE_CORTO=MiNegocio

# Base de datos (si no se define, usa SQLite)
# DATABASE_URL=postgres://usuario:clave@localhost:5432/sistventas
# Segundos que se reusa la conexión a PostgreSQL (0 = una por petición)
# CONN_MAX_AGE=60

# Días que dura la sesión antes de pedir de nuevo la contraseña
# SESSION_DIAS=7

# En producción (DEBUG=False) la SECRET_KEY debe ser larga y secreta: el sistema no arranca con la de ejemplo.
# Clave para cifrar los secretos guardados en la base (token de Nubefact, código del celular). Si no se pone, se usa
# la SECRET_KEY. En producción ponla aparte (genera otra igual que la SECRET_KEY) y guárdala en un lugar seguro:
# si se pierde o se cambia, hay que volver a escribir el token y volver a activar el código del celular.
# CLAVE_CIFRADO=

# Fotos y logo en DigitalOcean Spaces (producción). Sin SPACES_BUCKET se guardan en la carpeta media/.
# Un espacio privado para todas las empresas; cada empresa en su carpeta.
# SPACES_BUCKET=sistventas-fotos
# SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
# SPACES_REGION=sfo3
# SPACES_KEY=
# SPACES_SECRET=
# SPACES_CARPETA=bodega-dona-rosa

# Avisos: si el sistema da un error, manda un correo a estas direcciones (separar con comas).
# ALERTAS_CORREO=soporte@ejemplo.com
# EMAIL_URL=smtp+tls://usuario:clave@smtp.gmail.com:587
# CORREO_REMITENTE=sistema@ejemplo.com
# Las imágenes subidas se sirven en /archivos/ solo a usuarios con permiso: no publiques la carpeta media/ en el servidor.

# Detrás del proxy del hosting (DigitalOcean App Platform, Render): 1. Así el bloqueo de intentos
# y la bitácora ven la IP real del cliente. En la PC local, 0.
# PROXIES_CONFIABLES=0

# Código del celular obligatorio para Administración. Por defecto: sí en producción (DEBUG=False),
# no en la PC local ni en las demos.
# DOS_FACTOR_OBLIGATORIO=True
